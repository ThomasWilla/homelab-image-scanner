# Dependency-Track API endpoint, for example: http://192.168.101.83:8086
DEPENDENCYTRACK_URL=http://dependencytrack.example.local:8080

# Create a team API key in Dependency-Track with BOM upload and project management permissions.
DEPENDENCYTRACK_API_KEY=change-me

# Scan interval in seconds. 86400 = daily.
SCAN_INTERVAL_SECONDS=86400

# Local paths inside the container.
STATE_DB_PATH=/data/state/scanner.db
OUTPUT_DIR=/data/output
LOG_LEVEL=INFO
